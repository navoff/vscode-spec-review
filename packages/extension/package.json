{
  "name": "vscode-spec-review",
  "displayName": "Spec Review",
  "description": "Review Markdown documents written by AI agents: comments, revisions and diffs like a pull request",
  "version": "0.1.0",
  "publisher": "navoff",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "review",
    "markdown",
    "spec",
    "claude",
    "codex"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "tsc -p . && node esbuild.mjs",
    "test": "tsc -p . && node --test \"out/test/**/*.test.js\"",
    "package": "npm run build --prefix ../.. && vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "specReview.open",
        "title": "Open in Spec Review",
        "category": "Spec Review",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "specReview.installSkill",
        "title": "Install Agent Skill",
        "category": "Spec Review"
      },
      {
        "command": "specReview.comment",
        "title": "Comment on Selection",
        "category": "Spec Review"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "specReview.open",
          "when": "resourceLangId == markdown || resourceExtname == .md",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "specReview.open",
          "when": "resourceLangId == markdown || resourceExtname == .md",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "specReview.comment",
          "when": "activeWebviewPanelId == specReview.panel"
        }
      ],
      "editor/context": [
        {
          "command": "specReview.open",
          "when": "resourceLangId == markdown || resourceExtname == .md",
          "group": "navigation@1"
        }
      ],
      "webview/context": [
        {
          "command": "specReview.comment",
          "when": "webviewId == specReview.panel",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "specReview.comment",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "activeWebviewPanelId == specReview.panel"
      }
    ],
    "configuration": {
      "title": "Spec Review",
      "properties": {
        "specReview.skillTargets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/.claude/skills",
            "~/.codex/skills"
          ],
          "description": "Directories the agent skill is copied into by \"Install Agent Skill\". A spec-review folder is created inside each."
        }
      }
    }
  },
  "dependencies": {
    "@spec-review/core": "*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "jsdom": "^29.1.1"
  }
}
